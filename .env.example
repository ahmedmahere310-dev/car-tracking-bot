# توكن البوت اللي هتاخده من BotFather على تليجرام
TELEGRAM_BOT_TOKEN=

# بيانات قاعدة بيانات Turso (من turso.tech بعد إنشاء الداتابيز)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# للتشغيل المحلي بدون Turso، سيب الاتنين فوق فاضيين وهيستخدم ملف SQLite محلي بدلهم
LOCAL_DB_PATH=./db/data.sqlite

# بورت الداشبورد (Render بيحطه تلقائي، محتاجه بس للتشغيل المحلي)
PORT=3000
